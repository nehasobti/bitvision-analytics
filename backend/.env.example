# Connection to the BitVision MySQL database.
# Use a read-only MySQL user outside local development.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/bitvision_development

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Maximum rows written to an Excel/PDF export
EXPORT_MAX_ROWS=50000

# Language of the app and exports: it or en (texts in app/locales/)
APP_LANGUAGE=it
